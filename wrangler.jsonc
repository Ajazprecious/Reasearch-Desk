{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchdesk-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SEED_DEMO_DATA": "true",
    "ALLOWED_ORIGINS": "http://localhost:5173,https://researchdesk.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "researchdesk",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "researchdesk-uploads"
    }
  ]
}
